# syntax=docker/dockerfile:1.7
FROM php:8.2-apache-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends libcurl4-openssl-dev libfreetype6-dev libjpeg62-turbo-dev libonig-dev libpng-dev libzip-dev unzip \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" curl ftp gd mbstring mysqli pdo_mysql zip \
 && a2enmod rewrite \
 && sed -ri 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf \
 && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/root/.cache/composer composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader
COPY . .
RUN cp _build/build.config.sample.php _build/build.config.php \
 && cp _build/build.properties.sample.php _build/build.properties.php \
 && cp ht.access .htaccess \
 && chown -R www-data:www-data /var/www/html
