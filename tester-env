#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./tester-env <deploy|reset|seed|verify|stop|status|logs|help> [--run-id ID] [--port PORT]
Environment: IMAGE_TAG (default tester-env-modx-revolution:dev), RUN_ID, PORT (default 8096).
Credentials: tester-admin / modx-17082005 at /manager/.
EOF
}

run_id="${RUN_ID:-}"
port="${PORT:-8096}"
command="${1:-help}"
shift || true
while (($#)); do
  case "$1" in
    --run-id) run_id="$2"; shift 2 ;;
    --port) port="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done
case "$run_id" in '') suffix='' ;; *) suffix="-$run_id" ;; esac
export RUN_SUFFIX="$suffix" PORT="$port" COMPOSE_PROJECT_NAME="tester-env-modx-revolution${suffix}"
compose=(docker compose -f "$(dirname "$0")/docker-compose.tester-env.yml")

install_modx() {
  "${compose[@]}" exec -T --user www-data app php _build/transport.core.php
  "${compose[@]}" exec -T --user www-data app php setup/cli-install.php \
    --database_server=mysql --database=modx --database_user=modx --database_password=modx \
    --cmsadmin=tester-admin --cmspassword=modx-17082005 --cmsadminemail=admin@example.test \
    --http_host=localhost --table_prefix=modx_ --language=en --inplace=1 --unpacked=0 --remove_setup_directory=0
  "${compose[@]}" exec -T app php -r 'require "core/config/config.inc.php"; exit(isset($database_dsn) ? 0 : 1);'
}

case "$command" in
  deploy)
    echo '==> Building MODX from source and starting services'
    "${compose[@]}" up --build -d
    "${compose[@]}" exec -T app sh -lc 'until php -r "new PDO(\"mysql:host=mysql;dbname=modx\", \"modx\", \"modx\");"; do sleep 1; done'
    if ! "${compose[@]}" exec -T app test -f core/config/config.inc.php; then
      echo '==> Building MODX core package and installing MODX'
      install_modx
    fi
    echo "==> Ready: http://localhost:$port/"
    ;;
  reset)
    echo '==> Removing MODX app services and database volume'
    "${compose[@]}" down -v --remove-orphans
    ;;
  seed)
    echo '==> Seeding deterministic MODX resources'
    "${compose[@]}" exec -T --user www-data app php tester-env-seed.php
    ;;
  verify)
    echo '==> Checking MODX site, manager, and seeded resources'
    curl --fail --silent --show-error "http://localhost:$port/" >/dev/null
    manager_page="$(curl --fail --silent --show-error "http://localhost:$port/manager/")"
    [[ "$manager_page" == *MODX* ]]
    "${compose[@]}" exec -T --user www-data app php -r '
      define("MODX_API_MODE", true); require "index.php"; $modx->initialize("mgr");
      $rows = $modx->getCollection("MODX\\Revolution\\modResource", ["alias:IN" => ["operations-hub", "harbor-safety-briefing", "autumn-berth-schedule"], "context_key" => "web"]);
      $actual = array_map(fn($row) => $row->get("pagetitle"), $rows); sort($actual);
      if ($actual !== ["Autumn Berth Schedule", "Harbor Safety Briefing", "Operations Hub"]) exit(1);
      $dir = (defined("MODX_BASE_PATH") ? MODX_BASE_PATH : "/var/www/html/") . "assets/sort-fixtures/";
      $expected = ["alpha-dock-manifest.txt" => gmmktime(10, 0, 0, 1, 10, 2024), "harbor-tide-log.txt" => gmmktime(10, 0, 0, 6, 15, 2024), "zulu-berth-report.txt" => gmmktime(10, 0, 0, 11, 20, 2024)];
      foreach ($expected as $name => $mtime) {
        $path = $dir . $name;
        if (!is_file($path) || filemtime($path) !== $mtime) exit(1);
      }
      $templateId = (int) $modx->getOption("default_template", null, 1);
      $notes = $modx->getObject("MODX\\Revolution\\modTemplateVar", ["name" => "berthNotes"]);
      if (!$notes || $notes->get("type") !== "textarea" || $notes->get("caption") !== "Berth Notes") exit(1);
      $noteProps = $notes->get("input_properties") ?: [];
      if (!array_key_exists("textareaGrow", $noteProps) || !empty($noteProps["textareaGrow"])) exit(1);
      if (($noteProps["textareaResizable"] ?? null) != true) exit(1);
      $imageTv = $modx->getObject("MODX\\Revolution\\modTemplateVar", ["name" => "berthImage"]);
      $dateTv = $modx->getObject("MODX\\Revolution\\modTemplateVar", ["name" => "berthInspectionDate"]);
      if (!$imageTv || $imageTv->get("type") !== "image") exit(1);
      if (!$dateTv || $dateTv->get("type") !== "date") exit(1);
      if (!empty($dateTv->get("input_properties"))) exit(1);
      foreach (["berthNotes", "berthImage", "berthInspectionDate"] as $tvName) {
        $tv = $modx->getObject("MODX\\Revolution\\modTemplateVar", ["name" => $tvName]);
        if (!$modx->getObject("MODX\\Revolution\\modTemplateVarTemplate", ["tmplvarid" => $tv->get("id"), "templateid" => $templateId])) exit(1);
      }
      $harborPath = (defined("MODX_BASE_PATH") ? MODX_BASE_PATH : "/var/www/html/") . "assets/tv-fixtures/harbor&crane.jpg";
      if (!is_file($harborPath) || md5_file($harborPath) !== "7806ba0f8cb19129bd9e7bdad51b2b25" || filemtime($harborPath) !== gmmktime(10, 0, 0, 9, 2, 2024)) exit(1);
      $schedule = $modx->getObject("MODX\\Revolution\\modResource", ["alias" => "autumn-berth-schedule", "context_key" => "web"]);
      if (!$schedule) exit(1);
      $imageVal = $modx->getObject("MODX\\Revolution\\modTemplateVarResource", ["tmplvarid" => $imageTv->get("id"), "contentid" => $schedule->get("id")]);
      $dateVal = $modx->getObject("MODX\\Revolution\\modTemplateVarResource", ["tmplvarid" => $dateTv->get("id"), "contentid" => $schedule->get("id")]);
      if (!$imageVal || $imageVal->get("value") !== "assets/tv-fixtures/harbor&crane.jpg") exit(1);
      if (!$dateVal || $dateVal->get("value") !== "2024-09-15 10:00:00") exit(1);
      $observer = $modx->getObject("MODX\\Revolution\\modUser", ["username" => "dock-observer"]);
      $admin = $modx->getObject("MODX\\Revolution\\modUser", ["username" => "tester-admin"]);
      if (!$observer || !$observer->get("active") || !$admin) exit(1);
      if (!$observer->passwordMatches("dock-observer-17082005")) exit(1);
      $msg = $modx->getObject("MODX\\Revolution\\modUserMessage", ["sender" => $observer->get("id"), "recipient" => $admin->get("id"), "subject" => "Dockside shift handover"]);
      if (!$msg || $msg->get("date_sent") !== "2024-09-02 09:00:00") exit(1);
    '
    ;;
  stop)
    echo '==> Stopping MODX services (preserving database volume)'
    "${compose[@]}" stop
    ;;
  status)
    "${compose[@]}" ps
    echo "==> URL: http://localhost:$port/"
    ;;
  logs) "${compose[@]}" logs --tail=200 ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
